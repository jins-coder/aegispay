# AegisPay Gateway Configuration Template
# SAFE DEFAULTS: Local development and testnets only

NODE_ENV=development
PORT=3000
ADMIN_PORT=3001
SIGNER_PORT=3002

# STRICT PRODUCTION GATES (Defaults MUST be false)
MAINNET_ENABLED=false
WITHDRAWALS_ENABLED=false

# Database Configuration
DATABASE_URL=postgres://aegispay:aegispay_dev_secret@localhost:5432/aegispay_dev
REDIS_URL=redis://localhost:6379

# Mock Signer Guardrails
SIGNER_ENVIRONMENT=local
SIGNER_MOCK_SECRET_HEADER=x-aegispay-mock-signer-auth

# Network RPC Endpoints (Testnets)
ETH_SEPOLIA_RPC=https://rpc.sepolia.org
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
TRON_NILE_RPC=https://nile.trongrid.io
